# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/backgrounds

# 一次性运维脚本不入库；但汉化 codemod 工具链要入库
# （它是"带闸门"的可复用工具，不是一次性脚本 —— 见
#  docs/01-Projects/R20260914-01-简体中文界面/05-执行记录_汉化落地.md §4）
/scripts/*
!/scripts/i18n-*.ts
!/scripts/user-sim*.mjs
!/scripts/lib/
!/scripts/lib/i18n-detect.ts

# 汉化工作目录：字典、清单、对照快照要入库；英文原文整树副本不入库
# （original-en/ 是源文件的整树副本，与 git 历史重复，回退请用 git checkout。
#  它是全流水线**唯一**一棵原文树，只读，由 scripts/i18n-snapshot.ts 生成。
#  早先还有一棵 backup/ 作为"撤销上一次替换"的缓冲，会在第二次 apply 后
#  混入中文，与 audit/delta/props 需要的"永不改变的英文原文"角色冲突，已删除。）
/i18n-work/original-en/

prisma/migrations
/lib/generated/prisma
# Prisma
prisma/*.db
prisma/*.db-journal

#files
moving-forward.md

# 历史对话回顾的工作副本（从 DSH 会话库导出，可再生），不入库
/prompts-master/

# 用户旅程模拟的临时夹具与产物
/.sim/